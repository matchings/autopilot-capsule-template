# hash:autogenerated
ARG REGISTRY_HOST
FROM $REGISTRY_HOST/codeocean/python-slim-uv:main-5692e50

ARG DEBIAN_FRONTEND=noninteractive
ARG GIT_ASKPASS
COPY git-ask-pass /

COPY postInstall /
COPY requirements.txt /requirements.txt
# The secret mount is available if secrets are configured, but postInstall does
# NOT require any secret to succeed. This keeps the environment buildable for
# users who have not set ANTHROPIC_API_KEY.
RUN --mount=type=secret,id=secrets \
    ( [ -f /run/secrets/secrets ] && . /run/secrets/secrets || true ) \
    && /postInstall
